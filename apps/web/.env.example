# Smart Catering Web — Local Environment Template (apps/web/.env)
# Salin berkas ini ke apps/web/.env untuk pengembangan lokal.

# Nama publik aplikasi yang ditampilkan pada antarmuka web
NEXT_PUBLIC_APP_NAME="Smart Catering"

# URL dasar API khusus server-side (SSR / Route Handlers di masa depan untuk menghindari CORS browser; belum dipanggil pada Fase 0)
API_BASE_URL="http://localhost:3001"
