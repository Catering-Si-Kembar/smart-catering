# Smart Catering — sumber env backend dan infrastruktur.
# Salin sekali ke root .env. Frontend hanya memakai apps/web/.env.
# Launcher meneruskan variabel sesuai service; root env tidak diekspor global.
# Variabel proses terinjeksi mengalahkan nilai file. Nilai ${VAR} dibaca literal
# oleh launcher Node/Python; tulis URL lengkap, bukan ekspansi silang variabel.

# Listener native host. Port internal container VPS tetap 3001/8001/3002.
API_HOST=127.0.0.1
API_PORT=3001
AI_HOST=127.0.0.1
AI_PORT=8001
WORKER_HOST=127.0.0.1
WORKER_PORT=3002

# API/Prisma. Biarkan kosong untuk health/setup offline; isi sebelum akses DB nyata.
DATABASE_URL=
AI_SERVICE_URL=http://127.0.0.1:8001
WAHA_BASE_URL=http://127.0.0.1:3003
WAHA_API_KEY=

# AI service; belum ada panggilan Chroma/RAG pada Fase 0.
CHROMA_URL=http://127.0.0.1:8000

# Docs kedua backend: kosong => aktif saat dev, tertutup saat produksi.
# dev/start menetapkan mode runtime; jangan menaruh NODE_ENV/APP_ENV di sini.
# Jika produksi DOCS_ENABLED=true, wajib TLS + username + password >=32 karakter.
DOCS_ENABLED=
DOCS_USERNAME=
DOCS_PASSWORD=

# Docker Compose: isi password/key berbeda sebelum command Compose apa pun.
# Buat nilai acak, misalnya: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_USER=smartcatering
POSTGRES_PASSWORD=
POSTGRES_DB=smart_catering
POSTGRES_PORT=5432
CHROMA_PORT=8000
WAHA_PORT=3003
# Khusus VPS: URL lengkap dengan host postgres:5432 dan credential ter-URL-encode.
VPS_DATABASE_URL=
